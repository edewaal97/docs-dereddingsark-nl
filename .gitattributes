# Default for all files: Treat as text and store with LF in the repo.
* text=auto eol=lf

# Explicitly define common binary file types to prevent line ending conversion and diffing.
*.avif binary
*.woff2 binary
*.woff binary
*.eot binary
*.ttf binary
*.otf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary